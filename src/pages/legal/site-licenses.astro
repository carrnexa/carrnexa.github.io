---
import {carrNexaSoftwareLicenseEntry, siteLicenseEntries} from "@/config/licenses";
import {siteConfig} from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const siteLicenseSections = [
  {
    ...siteLicenseEntries[0],
    href: siteConfig.sourceCodeLicenseUrl,
    linkLabel: "Open LICENSE-CODE",
  },
  {
    ...siteLicenseEntries[1],
    href: siteConfig.contentLicenseUrl,
    linkLabel: "Open LICENSE-CONTENT",
  },
] as const;

const otherCarrNexaLicenses = [
  {
    ...carrNexaSoftwareLicenseEntry,
    href: siteConfig.softwareLicensePath,
    linkLabel: "Open dedicated license page",
  },
] as const;
---

<BaseLayout
  title="Licenses | CarrNexa"
  description="License terms for the CarrNexa website repo and a reference license used by other CarrNexa software." 
  canonicalPath="/legal/site-licenses.html"
  ogType="article"
>
  <section class="hero container">
    <h1 class="hero-title text-primary">Licenses</h1>
    <p class="hero-subtitle">One place to see what applies.</p>
    <p>
      This page is the legal map. The website repo uses separate licenses for code and content,
      and some other CarrNexa software uses a different source-available license.
    </p>
  </section>

  <section class="legal container">
    <div class="legal-card legal-nav-card">
      <h2 class="text-primary">Contents</h2>
      <div class="legal-nav">
        <a class="text-link" href="#site-code">Site source code</a>
        <a class="text-link" href="#site-content">Site content and brand assets</a>
        <a class="text-link" href="#carrnexa-software">Other CarrNexa software</a>
      </div>
    </div>
  </section>

  <section class="legal container legal-stack">
    <h2 class="section-title text-primary">This site</h2>
    {
      siteLicenseSections.map((section) => (
        <article id={section.id} class="legal-card legal-section">
          <h3 class="text-primary">{section.title}</h3>
          <p>{section.summary}</p>
          <div class="legal-actions">
            <a class="text-link" href={section.href} target="_blank" rel="noopener noreferrer">
              {section.linkLabel}
            </a>
          </div>
          <details class="legal-disclosure">
            <summary>View full text</summary>
            <pre class="legal-text">{section.text}</pre>
          </details>
        </article>
      ))
    }
  </section>

  <section class="legal container legal-stack">
    <h2 class="section-title text-primary">Other CarrNexa software</h2>
    <div class="values-grid">
      {
        otherCarrNexaLicenses.map((section) => (
          <article id={section.id} class="value-item legal-section">
            <h3 class="text-primary">{section.title}</h3>
            <p>{section.summary}</p>
            <div class="legal-actions">
              <a
                class="text-link"
                href={section.href}
                target={section.href.startsWith("http") ? "_blank" : undefined}
                rel={section.href.startsWith("http") ? "noopener noreferrer" : undefined}
              >
                {section.linkLabel}
              </a>
            </div>
            <details class="legal-disclosure">
              <summary>View full text</summary>
              <pre class="legal-text">{section.text}</pre>
            </details>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
