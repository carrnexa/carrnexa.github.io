---
import {carrNexaSoftwareLicenseEntry} from "@/config/licenses";
import {siteConfig} from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="CarrNexa Proprietary License | CarrNexa"
  description="Reference text for CarrNexa software that uses the CarrNexa proprietary source-available license."
  canonicalPath="/legal/license.html"
  ogType="article"
  includeMonoFonts={true}
>
  <section class="hero container">
    <h1 class="hero-title text-primary">{carrNexaSoftwareLicenseEntry.title}</h1>
    <p class="hero-subtitle">Reference text for software that uses this license.</p>
    <p>
      This page exists as a stable source of truth for CarrNexa software that ships under this
      source-available license. Repository-specific LICENSE files still control the terms for any
      individual repository.
    </p>
  </section>

  <section class="legal container">
    <div class="legal-card">
      <p>
        This page does not override repository-specific LICENSE files. The CarrNexa website repo
        itself uses separate licenses for code and content.
      </p>
      <p>
        <a class="text-link" href={siteConfig.siteLicensesPath}>View this site's licenses</a>
      </p>
    </div>
  </section>

  <section class="legal container">
    <div class="legal-card">
      <pre class="legal-text">{carrNexaSoftwareLicenseEntry.text}</pre>
    </div>
  </section>
</BaseLayout>
