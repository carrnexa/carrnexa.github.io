---
import {siteConfig} from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const licenseSections = [
  {
    title: "Source code",
    summary:
      "Unless a file says otherwise, the code in this repository is released under the MIT License. You can use, modify, and redistribute it, including for commercial work, as long as the license notice stays with the code.",
    href: siteConfig.sourceCodeLicenseUrl,
    linkLabel: "Read LICENSE-CODE",
  },
  {
    title: "Content and brand assets",
    summary:
      "Site content, writing, and brand assets are released under CC BY-NC 4.0 unless a file says otherwise. Attribution is required, and commercial reuse needs separate permission.",
    href: siteConfig.contentLicenseUrl,
    linkLabel: "Read LICENSE-CONTENT",
  },
] as const;
---

<BaseLayout
  title="Licensing | CarrNexa"
  description="License terms for the CarrNexa website code, content, and brand assets."
  canonicalPath="/legal/license.html"
  ogType="article"
>
  <section class="hero container">
    <h1 class="hero-title text-primary">Licensing</h1>
    <p class="hero-subtitle">The code and the content are not under the same license.</p>
    <p>
      This site uses a split license model. If you plan to reuse something, check which bucket it
      belongs to before you assume the terms are the same.
    </p>
  </section>

  <section class="legal container">
    <h2 class="section-title text-primary">What applies</h2>
    <div class="values-grid">
      {
        licenseSections.map((section) => (
          <article class="value-item">
            <h3 class="text-primary">{section.title}</h3>
            <p>{section.summary}</p>
            <p>
              <a
                class="text-link"
                href={section.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {section.linkLabel}
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="legal container">
    <div class="legal-card">
      <p>
        The repository is the source of truth for the exact license text. If a specific file ships
        with a different notice, follow the notice in that file.
      </p>
    </div>
  </section>
</BaseLayout>
