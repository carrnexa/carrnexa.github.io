{
  /* Copilot */
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".github/commit-instructions.md"
    }
  ],
  "chat.tools.terminal.autoApprove": {
    "npm run build": true,
    "npm run check": true,
    "npm run format": true
  },

  /* Formatting */
  "editor.formatOnSave": true,

  /* Markdown */
  "markdown.validate.enabled": true,
  "markdownlint.config": {
    "MD007": {
      "indent": 4
    },
    "MD033": {
      "table_allowed_elements": ["br"]
    }
  },

  /* XML */
  "xml.format.emptyElements": "collapse",
  "xml.format.enforceQuoteStyle": "preferred",
  "xml.format.preserveAttributeLineBreaks": false,
  "xml.format.preservedNewlines": 1,
  "xml.format.joinCommentLines": true,
  "xml.format.joinContentLines": true,
  "xml.format.maxLineWidth": 100,
  "redhat.telemetry.enabled": false,

  /* Associations */
  "files.associations": {
    // Markdown
    "*.md": "markdown",

    // YAML
    "*.yml": "yaml",
    "*.yaml": "yaml",

    // JSON and JSONC
    "*.json": "json",
    "*.jsonc": "jsonc",
    "*.manifest": "jsonc",
    "*.webmanifest": "jsonc",
    "*.code-snippets": "jsonc"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.tabSize": 2
  }
}
